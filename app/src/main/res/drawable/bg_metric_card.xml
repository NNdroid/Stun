<?xml version="1.0" encoding="utf-8"?>
<!-- 带宽测速面板「下载 / 上传」两张结果卡的底。
     用最亮的一档承载面（colorSurfaceContainerLowest）+ 一圈 outlineVariant 发丝边：
     它俩既要并排站在一起，又要从背后那块 bg_speed_panel 上"浮"起来，
     只靠亮度差不够，必须补一条边。
     圆角刻意比图表/状态行那两块（corner_lg）小一档：卡片只有 57dp 高，
     24dp 的圆角会吃掉近一半高度，两端看着就成半个胶囊、不像卡片了。
     1dp 是发丝线，按约定写裸值。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerLowest" />
    <corners android:radius="@dimen/corner_sm" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
</shape>
