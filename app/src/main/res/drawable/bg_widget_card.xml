<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件外框：圆角走 widget_card_radius —— API 31+ 是系统变量
     （各 ROM 的官方圆角），低版本回落到 22dp。见 values/dimens.xml 与 values-v31/dimens.xml。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_card_bg" />
    <corners android:radius="@dimen/widget_card_radius" />
    <stroke android:width="1dp" android:color="@color/widget_card_stroke" />
</shape>
