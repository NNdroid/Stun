<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Very light diagonal wash so the icon sits on a surface with a hint of
         depth instead of a dead flat fill. Deliberately low contrast: the
         launcher masks and tints this layer, and on themed-icon surfaces a
         stronger wash would fight the monochrome foreground. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:color="#FAFCFA"
                    android:offset="0.0" />
                <item
                    android:color="#F0F3F1"
                    android:offset="0.55" />
                <item
                    android:color="#E4E9E6"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
