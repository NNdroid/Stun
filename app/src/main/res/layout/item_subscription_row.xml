<?xml version="1.0" encoding="utf-8"?>
<!--
  订阅行：默认只读（标题 + 信息行），点头部展开编辑器（URL/PIN/名称/更新间隔 + 保存/删除）。
  信息行（row_info_line）结构被 SubscriptionRowLayoutTest 锁定：横向 LinearLayout，
  恰好 tv_row_info + tv_row_home 两个子项，主页是**只有链接图标**的入口（不显域名）、
  不与删除并排。重构只在其外围增删，不改这三者的父子关系。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_subscription_row"
    style="?attr/materialCardViewFilledStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="@dimen/corner_md"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_3">

        <!-- 头部：订阅名（无名称回退 URL 域名）+ 同步中指示 + 单独同步 + 更多菜单。
             整行可点，切换下方编辑器展开/收起。 -->
        <LinearLayout
            android:id="@+id/ll_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/pi_row_syncing"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="@dimen/space_2"
                android:indeterminate="true"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_row_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:text="My Airport" />

            <ImageButton
                android:id="@+id/btn_row_sync"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/subscription_row_sync"
                android:padding="@dimen/space_3"
                android:src="@drawable/ic_sync"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/btn_row_more"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/subscription_row_more"
                android:padding="@dimen/space_3"
                android:src="@drawable/ic_more_vert"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- 信息行：N 节点 · 每 X 小时自动更新 · 已同步（相对时间），尾部跟订阅主页图标入口。
             被测试锁定为恰好两个子项，勿在此容器内增删。 -->
        <LinearLayout
            android:id="@+id/row_info_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_row_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="12 nodes · synced 14:30"
                tools:visibility="visible" />

            <!-- 订阅主页入口：**只出链接图标，不出域名**。
                 域名（example.com）对用户没有信息量，而且"能不能点开外链"这件事
                 图标本身就说明了；文字部分恒为空（见 SubscriptionBottomSheet.VH.bind）。
                 ic_link 矢量是白的，颜色必须显式给 —— 光靠 drawableTint 走 attr 才不会
                 在浅色主题下变成白底白图标。 -->
            <TextView
                android:id="@+id/tv_row_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_link"
                android:drawableTint="?attr/colorPrimary"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:minWidth="@dimen/touch_target_min"
                android:padding="@dimen/space_2"
                android:visibility="gone"
                tools:ignore="ContentDescription"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- 失败原因（本地化），仅在同步失败时出现。 -->
        <TextView
            android:id="@+id/tv_row_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="The server returned an error"
            tools:visibility="visible" />

        <!-- 编辑器：默认收起，点头部或菜单"编辑"展开。 -->
        <LinearLayout
            android:id="@+id/ll_editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- 编辑区分区标题（2026-09-17 设计稿）：图标 + 标签，与流量卡的分区标题同一套排法 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:drawableStart="@drawable/ic_database"
                android:drawablePadding="@dimen/space_2"
                android:drawableTint="?attr/colorOnSurfaceVariant"
                android:text="@string/subscription_settings"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_row_url"
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:hint="@string/subscription_url_hint"
                app:startIconDrawable="@drawable/ic_link">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_row_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- PIN：ShareCryptoUtils 用任意字符串派生密钥，webui 也是纯文本输入，
                 这里不再是 numberPassword/6 位 —— 对齐两处口径。 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_row_pin"
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="@string/subscription_pin_hint"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_row_pin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLength="32"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_row_name"
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="@string/subscription_name_hint"
                app:startIconDrawable="@drawable/ic_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_row_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_row_interval"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="@string/subscription_interval_label"
                app:startIconDrawable="@drawable/ic_schedule">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/act_row_interval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    tools:ignore="LabelFor" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_row_remove"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/delete"
                    android:textColor="?attr/colorError" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_row_save"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/subscription_save" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
