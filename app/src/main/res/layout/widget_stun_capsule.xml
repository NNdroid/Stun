<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 快捷条：头像、节点/时延、双向实时速率图和连接按钮。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:contentDescription="@string/desc_open_app"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/widget_iv_logo"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_widget_logo"
        android:contentDescription="@string/app_name"
        android:padding="5dp"
        android:src="@drawable/ic_fox_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1.25"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_name"
            android:textColor="@color/widget_text_primary"
            android:textSize="@dimen/text_widget_lg"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_tv_status_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="@color/widget_down_accent"
                android:textSize="@dimen/text_widget_xs" />
            <TextView
                android:id="@+id/widget_tv_latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="@string/widget_preview_latency"
                android:textColor="@color/widget_down_accent"
                android:textSize="@dimen/text_widget_md"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_pill_up"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/widget_iv_graph_up"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_graph_preview_up" />
        <TextView
            android:id="@+id/widget_tv_speed_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_speed_up_short"
            android:textColor="@color/widget_text_primary"
            android:textSize="@dimen/text_widget_sm"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_pill_down"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/widget_iv_graph_down"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_graph_preview_down" />
        <TextView
            android:id="@+id/widget_tv_speed_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_speed_down_short"
            android:textColor="@color/widget_text_primary"
            android:textSize="@dimen/text_widget_sm"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_btn_toggle"
        android:layout_width="48dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_widget_button_disconnect"
        android:contentDescription="@string/desc_start_stop_button"
        android:gravity="center"
        android:orientation="vertical">
        <ProgressBar
            android:id="@+id/widget_progress_toggle"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/widget_up_accent"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/widget_iv_toggle"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_stop_rounded"
            android:tint="#EF4444" />
        <TextView
            android:id="@+id/widget_tv_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/disconnect"
            android:textColor="#EF4444"
            android:textSize="@dimen/text_widget_sm"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
