<?xml version="1.0" encoding="utf-8"?>
<!-- 迷你版（2x2）：名称、状态点与时延，下方两个 40dp 圆钮显示上下行速率。
     保留隐藏的连接按钮 id 供共用 Provider 安全绑定，但迷你版视觉上不额外堆叠操作栏。
     这里必须用 android:tint：RemoteViews 不走 AppCompat 的 LayoutInflater 工厂，
     app:tint 在桌面组件里不会生效，故压制 UseAppTint。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_iv_logo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_widget_logo"
            android:contentDescription="@string/app_name"
            android:padding="4dp"
            android:src="@drawable/ic_fox_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_preview_name"
                android:textColor="@color/widget_text_primary"
                android:textSize="@dimen/text_widget_lg"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_tv_status_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/text_widget_xs" />

                <TextView
                    android:id="@+id/widget_tv_latency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="@string/widget_preview_latency"
                android:textColor="@color/widget_down_accent"
                    android:textSize="@dimen/text_widget_md"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_iv_chevron"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/desc_open_app"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/widget_text_secondary" />
    </LinearLayout>

    <!-- 出口信息（探测到的公网出口 IP + 位置 + 国旗），仅连接态显示。
         迷你版空间紧张，故只给一行、9sp、超出省略；未连接时 GONE，不占高度。 -->
    <TextView
        android:id="@+id/widget_tv_exit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="@dimen/text_widget_xs"
        android:visibility="gone"
        tools:text="203.0.113.8 · 🇸🇬 Singapore" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_pill_up"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_iv_up"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_widget_circle_up"
                android:contentDescription="@string/widget_uplink"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_up"
                android:tint="@color/widget_up_accent" />

            <TextView
                android:id="@+id/widget_tv_speed_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="@string/widget_preview_speed_up_short"
                android:textColor="@color/widget_up_accent"
                android:textSize="@dimen/text_widget_lg"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_pill_down"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_iv_down"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_widget_circle_down"
                android:contentDescription="@string/widget_downlink"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_down"
                android:tint="@color/widget_down_accent" />

            <TextView
                android:id="@+id/widget_tv_speed_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="@string/widget_preview_speed_down_short"
                android:textColor="@color/widget_down_accent"
                android:textSize="@dimen/text_widget_lg"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_btn_toggle"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_button_connect"
        android:contentDescription="@string/desc_start_stop_button"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/widget_progress_toggle"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/widget_up_accent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_iv_toggle"
            android:contentDescription="@null"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_play"
            android:tint="#EF4444" />

        <TextView
            android:id="@+id/widget_tv_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/connect"
            android:textColor="#EF4444"
            android:textSize="@dimen/text_widget_md"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
