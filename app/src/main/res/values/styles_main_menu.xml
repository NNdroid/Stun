<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StunMainMenuAction">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_menu_action</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:minHeight">112dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="StunMainMenuActionIcon" parent="StunMenuIconPlate">
    </style>

    <style name="StunMainMenuActionIconImage" parent="StunMenuIcon">
    </style>

    <style name="StunMainMenuActionLabel">
        <item name="android:importantForAccessibility">no</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:gravity">top|center_horizontal</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 卡片副文案：灰色小字说明，与标题同列居中 -->
    <style name="StunMainMenuActionDesc">
        <item name="android:importantForAccessibility">no</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">top|center_horizontal</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="StunMainMenuDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <style name="StunMainMenuSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 「通用」分组的整宽卡片：图标在左、标题+描述在右，与方形磁贴同一套底色 -->
    <style name="StunMainMenuWideCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_menu_action</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">84dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="StunMainMenuWideCardTitle">
        <item name="android:importantForAccessibility">no</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StunMainMenuWideCardDesc">
        <item name="android:importantForAccessibility">no</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="StunWideMenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">68dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="StunWideMenuRowIcon" parent="StunMenuIconPlate">
    </style>

    <style name="StunWideMenuRowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- M3-style small group header for the flat side sheet -->
    <style name="StunSideSheetSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

</resources>
