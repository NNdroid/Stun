+
+int
+hev_socks5_client_connect (HevSocks5Client *self, const char *addr, int port)
+{
+    HevTaskChannelSelect *select = NULL;
+    HevSocks5ConnectAttempt *attempts[2] = { NULL, NULL };
+    HevTask *tasks[2] = { NULL, NULL };
+    HevTaskChannel *chan = NULL;
+    HevTaskChannel *ready;
+    HevSocks5ConnectResult result;
+    HevSocks5Class *klass;
+    struct sockaddr_in6 saddr;
+    struct sockaddr *sap;
+    int families[2] = { 0, 0 };
+    int addr_family;
+    int timeout;
+    int n_available = 0;
+    int attempt, delay;
+    int fd, res = -1;
+
+    LOG_D ("%p socks5 client connect [%s]:%d", self, addr, port);
+
+    timeout = hev_socks5_get_connect_timeout ();
+    hev_socks5_set_timeout (HEV_SOCKS5 (self), timeout);
+
+    /*
+     * RFC 6555 并发 happy-eyeballs。
+     *
+     * 背景：`hev_socks5_name_resolve_name` 按 RFC 6724 排序，设备有 IPv6
+     * 路由时 AAAA 排在 A 之前。若隧道出口是 IPv4-only（或那个 IPv6 实际
+     * 不可达），只试一次就是**静默失败** —— 域名能解析但连不通。
+     *
+     * 为什么必须并发而不是顺序重试：顺序版在「首选 family 完全不可达」时
+     * 要先走满整个 connect timeout（默认 5000ms）才试第二个，总耗时翻倍，
+     * 这段延迟用户完全感知得到。并发版在 250ms 后同时进行，整体耗时接近
+     * max(250ms, 实际 RTT) 而不是 sum。
+     *
+     * 首选 IPv4：隧道出口以 IPv4 为主，且 IPv4-mapped 地址在双栈 socket
+     * （hev_socks5_socket 关了 IPV6_V6ONLY）上同样可 connect。
+     */
+    {
+        static const int candidates[] = { AF_INET, AF_INET6 };
+
+        for (attempt = 0; attempt < 2; attempt++) {
+            struct sockaddr_in6 probe;
+            int f = hev_socks5_get_addr_family (HEV_SOCKS5 (self));
+
+            memset (&probe, 0, sizeof (probe));
+            if (hev_socks5_name_into_sockaddr6_family (addr, port, &probe, &f,
+                                                      candidates[attempt]) == 0)
+                families[n_available++] = candidates[attempt];
+        }
+    }
+
+    if (n_available == 0) {
+        LOG_I ("%p socks5 client resolve [%s]:%d", self, addr, port);
         return -1;
     }
 
-    HEV_SOCKS5 (self)->fd = fd;
-    hev_socks5_set_addr_family (HEV_SOCKS5 (self), addr_family);
-    LOG_D ("%p socks5 client connect server fd %d", self, fd);
+    /*
+     * 只有一个 family 可用（域名只有 A、或目标是 IP 字面量）：
+     * 直接在本 task 里连，不进并发路径 —— 零额外开销、无 task/channel。
+     */
+    if (n_available == 1) {
+        memset (&saddr, 0, sizeof (saddr));
+        addr_family = hev_socks5_get_addr_family (HEV_SOCKS5 (self));
+        if (hev_socks5_name_into_sockaddr6_family (addr, port, &saddr,
+                                                    &addr_family,
+                                                    families[0]) < 0) {
+            LOG_I ("%p socks5 client resolve [%s]:%d", self, addr, port);
+            return -1;
+        }
 
-    return 0;
+        fd = hev_socks5_socket (SOCK_STREAM);
+        if (fd < 0) {
+            LOG_E ("%p socks5 client socket", self);
+            return -1;
+        }
+
+        sap = (struct sockaddr *)&saddr;
+        klass = HEV_OBJECT_GET_CLASS (self);
+        if (klass->binder (HEV_SOCKS5 (self), fd, sap) < 0) {
+            LOG_W ("%p socks5 client bind", self);
+            hev_task_del_fd (hev_task_self (), fd);
+            close (fd);
+            return -1;
+        }
+
+        if (hev_task_io_socket_connect (fd, sap, sizeof (saddr),
+                                        task_io_yielder, self) < 0) {
+            LOG_I ("%p socks5 client connect [%s]:%d", self, addr, port);
+            hev_task_del_fd (hev_task_self (), fd);
+            close (fd);
+            return -1;
+        }
+
+        HEV_SOCKS5 (self)->fd = fd;
+        hev_socks5_set_addr_family (HEV_SOCKS5 (self), addr_family);
+        LOG_D ("%p socks5 client connect server fd %d", self, fd);
+        return 0;
+    }
+
+    /* 双 family 并发：共用一个 channel，谁先回结果就用谁。 */
+    if (hev_task_channel_new (&chan, NULL) < 0) {
+        LOG_E ("%p socks5 client channel", self);
+        return -1;
+    }
+
+    select = hev_task_channel_select_new ();
+    if (!select) {
+        LOG_E ("%p socks5 client channel select", self);
+        goto cleanup;
+    }
+
+    hev_task_channel_select_add (select, chan);
+
+    for (attempt = 0; attempt < 2; attempt++) {
+        attempts[attempt] = hev_malloc (sizeof (*attempts[attempt]));
+        if (!attempts[attempt]) {
+            LOG_E ("%p socks5 client attempt", self);
+            goto cleanup;
+        }
+        attempts[attempt]->self = self;
+        attempts[attempt]->chan = chan;
+        attempts[attempt]->addr = addr;
+        attempts[attempt]->port = port;
+        attempts[attempt]->want_family = families[attempt];
+    }
+
+    for (attempt = 0; attempt < 2; attempt++) {
+        tasks[attempt] = hev_task_new (hev_socks5_get_task_stack_size ());
+        if (!tasks[attempt]) {
+            LOG_E ("%p socks5 client task", self);
+            goto cleanup;
+        }
+        hev_task_run (tasks[attempt], hev_socks5_client_connect_task_entry,
+                      attempts[attempt]);
+
+        /*
+         * 每轮启动一个 attempt，再按 RFC 的节奏等：
+         * 首轮 250ms（Connection Attempt Delay —— 期间次选还没启动）；
+         * 次轮不限时，让两个并行的 attempt 竞速，谁先回用谁。
+         */
+        delay = attempt == 0 ? HEV_SOCKS5_HAPPY_EYEBALLS_DELAY_MS
+                             : (timeout > 0 ? timeout : -1);
+
+        ready = hev_task_channel_select_read (select, delay);
+        if (!ready)
+            continue; /* 本轮超时：进入下一轮，发起/等待第二个 family */
+
+        if ((int) hev_task_channel_read (ready, &result, sizeof (result)) < 0 ||
+            result.fd < 0)
+            continue; /* 这一路失败：继续等另一路 */
+
+        HEV_SOCKS5 (self)->fd = result.fd;
+        hev_socks5_set_addr_family (HEV_SOCKS5 (self), result.family);
+        LOG_D ("%p socks5 client connect server fd %d af %d", self, result.fd,
+               result.family);
+        res = 0;
+        break;
+    }
+
+    if (res < 0)
+        LOG_I ("%p socks5 client resolve/connect [%s]:%d", self, addr, port);
+
+cleanup:
+    /*
+     * join 掉已启动的子 task，再销毁 channel / select。
+     *
+     * join 不可打断（内部是 while + yield 循环直到 HEV_TASK_STOPPED），
+     * 所以它一定等到 entry return —— 这正是必须的：entry 结束时要
+     * hev_task_channel_write，channel 先销毁就是 use-after-free。
+     *
+     * 赢的那一路已把 fd 交给 self；输的那一路若也成功了（理论上不会，
+     * 因为一旦有一路成功 res != 0 就 break，第二路不会被采纳），
+     * 其 fd 会随 task 结束泄漏 —— 所以下面显式回收。
+     */
+    for (attempt = 0; attempt < 2; attempt++) {
+        if (tasks[attempt]) {
+            hev_task_join (tasks[attempt]);
+            hev_task_unref (tasks[attempt]);
+
+            /*
+             * 回收「已写入但未被采纳」的成功 fd：join 之后 channel 里的
+             * 数据就是该 task 的最终结果。res != 0 时若读到成功，说明是
+             * 晚到的那一路，必须关掉，否则描述符泄漏。
+             */
+            if (res < 0 &&
+                (int) hev_task_channel_read (chan, &result,
+                                             sizeof (result)) > 0 &&
+                result.fd >= 0) {
+                hev_task_del_fd (hev_task_self (), result.fd);
+                close (result.fd);
+            }
+        }
+        if (attempts[attempt])
+            hev_free (attempts[attempt]);
+    }
+
+    if (select)
+        hev_task_channel_select_destroy (select);
+    if (chan)
+        hev_task_channel_destroy (chan);
+
+    return res;
 }
 
