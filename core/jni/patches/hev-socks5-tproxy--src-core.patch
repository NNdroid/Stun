+
+int
+hev_socks5_name_into_sockaddr6_family (const char *name, int port,
+                                       struct sockaddr_in6 *saddr, int *family,
+                                       int want_family)
+{
+    struct addrinfo hints = { 0 };
+    struct addrinfo *result = NULL;
+    struct addrinfo *ai;
+    int res = -1;
+
+    memset (saddr, 0, sizeof (*saddr));
+    saddr->sin6_family = AF_INET6;
+    saddr->sin6_port = htons (port);
+
+    /* IP 字面量：inet_pton 判定，与 DNS 无关，两个 family 都会命中同一个。 */
+    if (hev_socks5_name_resolve_ipv4 (name, saddr) == 0 ||
+        hev_socks5_name_resolve_ipv6 (name, saddr) == 0) {
+        struct in6_addr a6 = saddr->sin6_addr;
+
+        if (IN6_IS_ADDR_V4MAPPED (&a6)) {
+            if (want_family != AF_INET && want_family != AF_UNSPEC) {
+                /* 调用方只要 IPv6，而这个字面量是 IPv4 ⇒ 本轮不适用。 */
+                return -1;
+            }
+            *family = HEV_SOCKS5_ADDR_FAMILY_IPV4;
+        } else {
+            if (want_family != AF_INET6 && want_family != AF_UNSPEC)
+                return -1;
+            *family = HEV_SOCKS5_ADDR_FAMILY_IPV6;
+        }
+        return 0;
     }
-    default:
-        res = -1;
+
+    hints.ai_family = want_family;
+    hints.ai_socktype = SOCK_STREAM;
+
+    hev_task_dns_getaddrinfo (name, NULL, &hints, &result);
+    if (!result)
+        return -1;
+
+    for (ai = result; ai; ai = ai->ai_next) {
+        if (want_family == AF_INET && ai->ai_family == AF_INET) {
+            struct sockaddr_in *sa = (struct sockaddr_in *)ai->ai_addr;
+            memset (&saddr->sin6_addr, 0, 10);
+            saddr->sin6_addr.s6_addr[10] = 0xff;
+            saddr->sin6_addr.s6_addr[11] = 0xff;
+            memcpy (&saddr->sin6_addr.s6_addr[12], &sa->sin_addr, 4);
+            *family = HEV_SOCKS5_ADDR_FAMILY_IPV4;
+            res = 0;
+            break;
+        }
+        if (want_family == AF_INET6 && ai->ai_family == AF_INET6) {
+            struct sockaddr_in6 *sa = (struct sockaddr_in6 *)ai->ai_addr;
+            memcpy (&saddr->sin6_addr, &sa->sin6_addr, 16);
+            *family = HEV_SOCKS5_ADDR_FAMILY_IPV6;
+            res = 0;
+            break;
+        }
     }
 
     freeaddrinfo (result);
