--- a/src/hev-socks5-session-tcp.c
+++ b/src/hev-socks5-session-tcp.c
@@ -7,5 +7,6 @@
  ============================================================================
  */
 
+#include <arpa/inet.h>
 #include <errno.h>
 #include <string.h>
@@ -21,6 +22,7 @@
 
 #include "hev-utils.h"
 #include "hev-config.h"
+#include "hev-domain-sniff.h"
 #include "hev-logger.h"
 #include "hev-config-const.h"
 #include "hev-socks5-tunnel.h"
@@ -177,6 +179,87 @@
     return self;
 }
 
+static uint16_t
+hev_socks5_session_tcp_port (HevSocks5SessionTCP *self)
+{
+    HevSocks5Addr *addr = self->base.addr;
+
+    if (!addr)
+        return 0;
+    if (addr->atype == HEV_SOCKS5_ADDR_TYPE_IPV4)
+        return addr->ipv4.port;
+    if (addr->atype == HEV_SOCKS5_ADDR_TYPE_IPV6)
+        return addr->ipv6.port;
+    return 0;
+}
+
+static void
+hev_socks5_session_tcp_set_domain (HevSocks5SessionTCP *self,
+                                   const char *domain, uint16_t port)
+{
+    HevSocks5Addr addr;
+    HevSocks5Addr *copy;
+    int len;
+
+    hev_socks5_addr_from_name (&addr, domain, port);
+    len = hev_socks5_addr_len (&addr);
+    if (len <= 0)
+        return;
+    copy = hev_malloc (len);
+    if (!copy)
+        return;
+    memcpy (copy, &addr, len);
+    if (self->base.addr)
+        hev_free (self->base.addr);
+    self->base.addr = copy;
+}
+
+void
+hev_socks5_session_tcp_sniff (HevSocks5SessionTCP *self)
+{
+    unsigned char buf[8192];
+    char domain[256];
+    uint16_t raw_port;
+    int port, tries, i;
+
+    if (!self || !self->base.addr ||
+        self->base.addr->atype == HEV_SOCKS5_ADDR_TYPE_NAME)
+        return;
+
+    raw_port = hev_socks5_session_tcp_port (self);
+    if (!raw_port)
+        return;
+    port = ntohs (raw_port);
+    tries = port == 443 ? 8 : (port == 80 ? 4 : 1);
+
+    for (i = 0; i < tries; i++) {
+        size_t n = 0;
+
+        hev_task_mutex_lock (self->mutex);
+        if (self->queue) {
+            n = self->queue->tot_len;
+            if (n > sizeof (buf))
+                n = sizeof (buf);
+            n = pbuf_copy_partial (self->queue, buf, n, 0);
+        }
+        hev_task_mutex_unlock (self->mutex);
+
+        if (n > 0) {
+            int res = hev_domain_sniff (buf, n, domain, sizeof (domain));
+            if (res > 0) {
+                LOG_D ("%p recovered domain %s", self, domain);
+                hev_socks5_session_tcp_set_domain (self, domain, raw_port);
+                return;
+            }
+            if (res == 0)
+                return;
+        }
+
+        if (i + 1 < tries)
+            hev_task_sleep (10);
+    }
+}
+
 static int
 hev_socks5_session_tcp_bind (HevSocks5 *self, int fd,
                              const struct sockaddr *dest)
