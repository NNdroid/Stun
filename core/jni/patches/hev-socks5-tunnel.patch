diff --git a/src/hev-domain-sniff.h b/src/hev-domain-sniff.h
new file mode 100644
--- /dev/null
+++ b/src/hev-domain-sniff.h
@@ -0,0 +1,14 @@
+#ifndef __HEV_DOMAIN_SNIFF_H__
+#define __HEV_DOMAIN_SNIFF_H__
+
+#include <stddef.h>
+
+/*
+ * Returns 1 when a trustworthy domain was recovered, 0 when the payload is
+ * complete/unsupported and must stay on the original IP, and -1 when more
+ * bytes may complete a TLS/HTTP header.
+ */
+int hev_domain_sniff (const unsigned char *buf, size_t len, char *domain,
+                      size_t domain_len);
+
+#endif /* __HEV_DOMAIN_SNIFF_H__ */
diff --git a/src/hev-domain-sniff.c b/src/hev-domain-sniff.c
new file mode 100644
--- /dev/null
+++ b/src/hev-domain-sniff.c
@@ -0,0 +1,243 @@
+#include <arpa/inet.h>
+#include <ctype.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "hev-domain-sniff.h"
+
+static uint16_t
+read_be16 (const unsigned char *p)
+{
+    return ((uint16_t)p[0] << 8) | p[1];
+}
+
+static size_t
+read_be24 (const unsigned char *p)
+{
+    return ((size_t)p[0] << 16) | ((size_t)p[1] << 8) | p[2];
+}
+
+static int
+valid_domain_char (unsigned char c)
+{
+    return isalnum (c) || c == '.' || c == '-' || c == '_';
+}
+
+static int
+copy_domain (const unsigned char *src, size_t len, char *dst, size_t dstlen)
+{
+    unsigned char ipbuf[16];
+    int has_alpha = 0;
+    size_t i;
+
+    if (!src || !dst || len == 0 || len > 253 || dstlen <= len)
+        return 0;
+    if (src[0] == '.' || src[len - 1] == '.')
+        return 0;
+
+    for (i = 0; i < len; i++) {
+        if (!valid_domain_char (src[i]))
+            return 0;
+        if (isalpha (src[i]))
+            has_alpha = 1;
+        dst[i] = (char)tolower (src[i]);
+    }
+    dst[len] = '\0';
+
+    /* Never turn a literal address back into SOCKS ATYP=DOMAIN. */
+    if (inet_pton (AF_INET, dst, ipbuf) == 1 ||
+        inet_pton (AF_INET6, dst, ipbuf) == 1)
+        return 0;
+
+    /* Avoid treating an all-numeric token as a host name. */
+    return has_alpha;
+}
+
+static int
+http_method (const unsigned char *buf, size_t len)
+{
+    static const char *methods[] = {
+        "GET ", "POST ", "HEAD ", "PUT ", "DELETE ", "OPTIONS ",
+        "CONNECT ", "PATCH ", "TRACE ",
+    };
+    size_t i;
+
+    for (i = 0; i < sizeof (methods) / sizeof (methods[0]); i++) {
+        size_t n = strlen (methods[i]);
+        if (len >= n && memcmp (buf, methods[i], n) == 0)
+            return 1;
+    }
+    return 0;
+}
+
+static int
+sniff_http (const unsigned char *buf, size_t len, char *domain,
+            size_t domain_len)
+{
+    size_t pos;
+
+    if (!http_method (buf, len))
+        return 0;
+
+    for (pos = 0; pos + 1 < len; ) {
+        size_t end = pos;
+        size_t value, value_end;
+
+        while (end + 1 < len && !(buf[end] == '\r' && buf[end + 1] == '\n'))
+            end++;
+        if (end + 1 >= len)
+            return -1;
+        if (end == pos)
+            return 0;
+
+        if (end - pos >= 5 &&
+            tolower (buf[pos]) == 'h' && tolower (buf[pos + 1]) == 'o' &&
+            tolower (buf[pos + 2]) == 's' && tolower (buf[pos + 3]) == 't' &&
+            buf[pos + 4] == ':') {
+            value = pos + 5;
+            while (value < end && (buf[value] == ' ' || buf[value] == '\t'))
+                value++;
+            value_end = end;
+            while (value_end > value &&
+                   (buf[value_end - 1] == ' ' || buf[value_end - 1] == '\t'))
+                value_end--;
+
+            /* Strip :port from a conventional hostname. IPv6 literals are
+             * rejected by copy_domain and therefore intentionally untouched. */
+            if (value < value_end && buf[value] != '[') {
+                size_t i;
+                for (i = value; i < value_end; i++) {
+                    if (buf[i] == ':') {
+                        value_end = i;
+                        break;
+                    }
+                }
+            }
+            return copy_domain (buf + value, value_end - value, domain,
+                                domain_len);
+        }
+        pos = end + 2;
+    }
+    return -1;
+}
+
+static int
+sniff_tls (const unsigned char *buf, size_t len, char *domain,
+           size_t domain_len)
+{
+    size_t record_len, hs_len, end, pos, ext_end;
+    const unsigned char *sni = NULL;
+    size_t sni_len = 0;
+    int encrypted_name = 0;
+
+    if (len == 0 || buf[0] != 0x16)
+        return 0;
+    if (len < 5)
+        return -1;
+
+    record_len = read_be16 (buf + 3);
+    if (record_len < 4)
+        return 0;
+    if (len < 5 + record_len)
+        return -1;
+    if (buf[5] != 0x01)
+        return 0;
+
+    hs_len = read_be24 (buf + 6);
+    if (hs_len + 4 > record_len)
+        return 0;
+    end = 9 + hs_len;
+    if (end > len)
+        return -1;
+
+    /* legacy_version + random */
+    pos = 9 + 2 + 32;
+    if (pos >= end)
+        return 0;
+
+    /* legacy_session_id */
+    if (pos + 1 > end)
+        return 0;
+    pos += 1 + buf[pos];
+    if (pos + 2 > end)
+        return 0;
+
+    /* cipher_suites */
+    {
+        size_t n = read_be16 (buf + pos);
+        pos += 2 + n;
+    }
+    if (pos + 1 > end)
+        return 0;
+
+    /* legacy_compression_methods */
+    pos += 1 + buf[pos];
+    if (pos == end)
+        return 0;
+    if (pos + 2 > end)
+        return 0;
+
+    ext_end = pos + 2 + read_be16 (buf + pos);
+    pos += 2;
+    if (ext_end > end)
+        return 0;
+
+    while (pos + 4 <= ext_end) {
+        uint16_t type = read_be16 (buf + pos);
+        size_t ext_len = read_be16 (buf + pos + 2);
+        const unsigned char *ext;
+        size_t epos, eend;
+
+        pos += 4;
+        if (pos + ext_len > ext_end)
+            return 0;
+        ext = buf + pos;
+
+        /* ECH / legacy ESNI: the visible SNI may be a cover name and must not
+         * be used to replace the original destination. */
+        if (type == 0xfe0d || type == 0xffce)
+            encrypted_name = 1;
+
+        if (type == 0x0000 && ext_len >= 5) {
+            size_t list_len = read_be16 (ext);
+            if (list_len + 2 > ext_len) {
+                pos += ext_len;
+                continue;
+            }
+            epos = 2;
+            eend = 2 + list_len;
+            while (epos + 3 <= eend) {
+                uint8_t name_type = ext[epos];
+                size_t name_len = read_be16 (ext + epos + 1);
+                epos += 3;
+                if (epos + name_len > eend)
+                    break;
+                if (name_type == 0 && name_len > 0 && !sni) {
+                    sni = ext + epos;
+                    sni_len = name_len;
+                }
+                epos += name_len;
+            }
+        }
+        pos += ext_len;
+    }
+
+    if (encrypted_name || !sni)
+        return 0;
+    return copy_domain (sni, sni_len, domain, domain_len);
+}
+
+int
+hev_domain_sniff (const unsigned char *buf, size_t len, char *domain,
+                  size_t domain_len)
+{
+    int res;
+
+    if (!buf || !domain || domain_len == 0)
+        return 0;
+
+    res = sniff_tls (buf, len, domain, domain_len);
+    if (res != 0)
+        return res;
+    return sniff_http (buf, len, domain, domain_len);
+}
