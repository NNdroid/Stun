<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Circular background disc matching the circular Launcher App Icon -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/splash_icon_bg" />
            <size
                android:width="160dp"
                android:height="160dp" />
        </shape>
    </item>
    <!-- Centered Fox Logo -->
    <item
        android:drawable="@drawable/ic_fox_logo"
        android:gravity="center"
        android:width="120dp"
        android:height="120dp" />
</layer-list>
