<?xml version="1.0" encoding="utf-8"?>
<!--
    Android TV launcher banner.

    Hard contract (Google Play TV-LB / TV-BN):
      * opaque background that fills the whole 320x180 canvas (no transparent edges)
      * the title must be fully inside a safe area (16 units on every side)
      * the title text must match android:label ("Stun TV") exactly
      * no border stroke along the canvas edge - the launcher crops it

    The xhdpi PNG under drawable-xhdpi/ is the policy-facing asset; this vector
    is the density-independent fallback for other Television density buckets.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Opaque full-bleed background -->
    <path
        android:fillColor="#131927"
        android:pathData="M0,0 h320 v180 h-320 z" />

    <!-- Ambient wash, intentionally bleeds to the edge (background, not logo) -->
    <path
        android:fillColor="#1E293B"
        android:pathData="M0,0 L180,0 L120,180 L0,180 Z" />

    <path
        android:fillColor="#1A2A1A05"
        android:pathData="M80,90 m-70,0 a70,70 0 1,0 140,0 a70,70 0 1,0 -140,0" />

    <!-- ==================== Fox mascot (left, safe area) ==================== -->
    <group
        android:translateX="26"
        android:translateY="20"
        android:scaleX="1.05"
        android:scaleY="1.05">

        <path
            android:fillColor="#1AFB8C00"
            android:pathData="M54,54 m-42,0 a42,42 0 1,0 84,0 a42,42 0 1,0 -84,0" />

        <path
            android:fillColor="#D84315"
            android:pathData="M40,35 C32,20 20,30 25,50 L50,45 Z" />

        <path
            android:fillColor="#FF9800"
            android:pathData="M68,35 C76,20 88,30 83,50 L58,45 Z" />

        <path
            android:fillColor="#FB8C00"
            android:pathData="M54,35 C28,35 15,52 15,72 C15,92 35,102 54,102 C73,102 93,92 93,72 C93,52 80,35 54,35 Z" />

        <path
            android:fillColor="#E64A19"
            android:pathData="M54,35 C28,35 15,52 15,72 C15,92 35,102 54,102 L54,35 Z" />

        <path
            android:fillColor="#FFFFFF"
            android:pathData="M54,102 C38,102 28,95 28,80 C28,70 42,65 54,78 C66,65 80,70 80,80 C80,95 70,102 54,102 Z" />

        <path
            android:fillColor="#212121"
            android:pathData="M43,68 A5,5 0 1,1 42.9,68 Z" />

        <path
            android:fillColor="#212121"
            android:pathData="M65,68 A5,5 0 1,1 64.9,68 Z" />

        <path
            android:fillColor="#FFFFFF"
            android:pathData="M44.5,66 A1.5,1.5 0 1,1 44.4,66 Z" />

        <path
            android:fillColor="#FFFFFF"
            android:pathData="M66.5,66 A1.5,1.5 0 1,1 66.4,66 Z" />

        <path
            android:fillColor="#212121"
            android:pathData="M54,82 A2,1.5 0 1,1 53.9,82 Z" />
    </group>

    <!-- ==================== Title: "Stun TV" ==================== -->
    <!-- Local glyph run is 204u wide; scale 0.78 -> 159u. At translateX=143 the
         right edge is 302, i.e. 18 units inside the 320 canvas. Before this fix
         the run was "STUN" at translateX=148 with 'N' ending at 322 -> cropped. -->
    <group
        android:translateX="143"
        android:translateY="70"
        android:scaleX="0.78"
        android:scaleY="0.78">

        <!-- S -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M20,2 C12,2 6,7 6,14 C6,22 15,25 22,28 C30,31 34,35 34,41 C34,48 27,52 19,52 C11,52 5,48 4,42 L10,40 C11,44 14,46 19,46 C24,46 28,44 28,41 C28,37 20,34 13,31 C6,28 0,23 0,15 C0,7 8,2 20,2 Z" />

        <!-- t -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M43,8 L48,8 L48,42 C48,47 51,50 56,50 L56,55 C47,55 43,49 43,42 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M35,20 L54,20 L54,25 L35,25 Z" />

        <!-- u -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M63,20 L68,20 L68,42 C68,47 72,50 77,50 C82,50 86,47 86,42 L86,20 L91,20 L91,42 C91,49 85,52 77,52 C69,52 63,49 63,42 Z" />

        <!-- n (outer contour + reverse-wound inner cutout so the arch reads as an arch) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M95,52 L95,20 C95,12 100,8 109,8 C118,8 123,12 123,20 L123,52 Z M100,52 L118,52 L118,22 C118,17 114,14 109,14 C104,14 100,17 100,22 Z" />

        <!-- T -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M135,2 L165,2 L165,8 L153,8 L153,52 L147,52 L147,8 L135,8 Z" />

        <!-- V -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M169,2 L176,2 L184,38 L192,2 L199,2 L188,52 L180,52 Z" />
    </group>

    <!-- Small orange underline: brand accent only, no text, well inside safe area -->
    <path
        android:fillColor="#FB8C00"
        android:pathData="M143,120 h130 v3 h-130 z" />
</vector>
