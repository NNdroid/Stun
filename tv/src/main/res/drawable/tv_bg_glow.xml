<?xml version="1.0" encoding="utf-8"?>
<!-- 右下角「地平线光晕」：径向琥珀渐变，垫在节点列表后面 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="70%p"
                android:startColor="#55F5A93B"
                android:centerColor="#22F5A93B"
                android:endColor="#00F5A93B" />
        </shape>
    </item>
</layer-list>
