<?xml version="1.0" encoding="utf-8"?>
<!-- 主背景：深海军蓝 + 顶部一道极淡的冷光渐变（效果图的对角氛围光） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/tv_bg_main" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#26203C5E"
                android:endColor="#00203C5E"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
