<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardBackgroundColor="@color/tv_card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/tv_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Main Row: Avatar + Name & Addr + Delay & Selected Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Region Flag / Avatar Icon -->
            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/shape_status_dot"
                android:backgroundTint="@color/tv_card_inner_bg"
                android:gravity="center"
                tools:text="🌐"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Node Title & Server Host -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Node Name"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAddr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.8"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    tools:text="1.2.3.4:22"
                    android:textColor="?attr/tvPublicIpColor"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- Delay & Selected Status Group -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="end|center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDelay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    tools:text="—"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_badge_type"
                    android:backgroundTint="?attr/colorPrimary"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="@string/tv_profile_selected_badge"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Badges Row: Protocol Type + Sub Feature Badge + Traffic Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_type"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                tools:text="SSH"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnTertiaryContainer"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_type"
                android:backgroundTint="@color/tv_card_inner_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text=""
                android:textColor="?attr/tvBadgeSubText"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvTraffic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:fontFamily="monospace"
                tools:text="↑ 0 B  ↓ 0 B"
                android:textColor="?attr/tvTrafficColor"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Focused Remote Key Hints (Visible only when card has focus) -->
        <TextView
            android:id="@+id/tvFocusHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.8"
            android:gravity="end"
            android:text="@string/tv_profile_focus_hint"
            android:textColor="?attr/tvFocusHintText"
            android:textSize="10.5sp"
            android:visibility="gone" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
