<?xml version="1.0" encoding="utf-8"?>
<!--
  覆盖 core 的默认列宽（core/src/main/res/values/dimens.xml 里是 360dp）。

  TV 是 10 尺 UI：常见电视横屏约 960dp，每列 480dp 正好两列、每张卡片接近手机屏宽，
  名字/地址/延迟那一排在 10 尺距离上才看得清；沿用 360dp 会切出 3 列（每列 320dp），
  卡片上的文字会挤。4K 电视（约 1920dp）下按 480dp 得 4 列。

  只覆盖这一个键，node_grid_min_width（多列门槛 600dp）继续用 core 的默认 —— 电视本来就远超它。
-->
<resources>
    <dimen name="node_grid_min_column">480dp</dimen>
</resources>
