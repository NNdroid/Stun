<?xml version="1.0" encoding="utf-8"?><!--
   云备份规则（API 31+）。与手机端 app/src/main/res/xml/data_extraction_rules.xml 同一套：
   排除 stun_prefs（Tink keyset，被 Android Keystore 主钥包裹）——Keystore 主钥不可迁移，
   恢复到新设备后无法解密且会导致 KeystoreUtils 初始化失败（WearApp/CarApp 里被静默吞掉）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="stun_prefs.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="stun_prefs.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
